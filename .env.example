# TRUVEX Environment Configuration Example
# Copy this file to .env and fill in the values

# Application
ENVIRONMENT=development
DEBUG=True
TRUVEX_HOST=127.0.0.1
TRUVEX_PORT=8000
SECRET_KEY=truvex_insecure_dev_key_replace_in_production_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=60
TRUST_ID_EXPIRY_MINUTES=10

# Database
DATABASE_URL=sqlite:///./truvex.db

# DetectifAI Credentials (Required for AI Voice Biometrics and Deepfake Detection)
# Obtain your API key at https://platform.detectif.ai (Dashboard > API Keys)
DETECTIF_API_KEY=dtf_live_your_actual_api_key_here
DETECTIF_BASE_URL=https://platform.detectif.ai
DETECTIF_MOCK_FALLBACK=True # Set to False when active DetectifAI API key with credits is provided
